        "Shopping list & styling guide",
      ],
      image: image2,
    },
    {
      name: "Full Renovation",
      featured: false,
      description: "End-to-end design management with on-site coordination.",
      features: [
        "Design development & drawings",
        "Contractor coordination",
        "Sourcing & site supervision",
      ],
      image: image3,
    },
    {
      name: "Space Planning Intensive",
      featured: false,
      description: "Detailed layout optimization for multi-room projects.",
      features: [
        "Functional zoning map",
        "Furniture placement scenarios",
        "Circulation flow refinements",
      ],
      image: image4,
    },
    {
      name: "Material & Palette Curation",
      featured: false,
      description: "Cohesive finishes and color schemes with sample boards.",
      features: [
        "Material sourcing shortlist",
        "Coordinated palette & textures",
        "Specification sheet for contractors",
      ],
      image: image5,
    },
    {
      name: "Styling Support",
      featured: false,
      description: "On-site styling and finishing touches before handover.",
      features: [
        "Decor & accessory selection",
        "Installation day styling",
        "Photography-ready detailing",
      ],
      image: image6,
    },
  ],
  el: [
    {
      name: "Συμβουλευτική",
      featured: false,
      description: "Δουλεύουμε με ευελιξία και δημιουργικότητα, από μια απλή συμβουλή μέχρι το πλήρες στήσιμο του χώρου σας.",
      features: [
        "+ Συμβουλές για interior styling, layout, χρωματικές επιλογές ή υλικά",
        "+ Συνεδρία εξ αποστάσεως (45' online call)",
        "+ Επίσκεψη στο χώρο σας - σας δίνουμε άμεσες και πρακτικές ιδέες για βελτίωση διάταξης, χρωμάτων, φωτισμού και styling"
      ],
      image: image1,
    },
    {
      name: "Τελευταία Πινελιά",
      featured: true,
      description: "Είτε έχετε ήδη έναν διαμορφωμένο χώρο που χρειάζεται ανανέωση, έιτε έχετε υλοποιήσει Πλήρη Μελέτη Χώρου και αναζητάτε την επιμέλεια των τελευταίων λεπτομερειών, αυτή η υπηρεσία είναι σχεδιασμένη για να συνδέσει το λειτουργικό με το εκλεπτυσμένο.",
      features: [
        "+ Mood boards & παλέτα υλικών",
        "+ Κάτοψη χώρου & σχέδιο επίπλων",
        "+ Λίστα αγορών & οδηγός styling",
      ],
