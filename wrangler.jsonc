{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www-atelier13",
  "compatibility_date": "2025-08-28",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "REPLACE_WITH_SESSION_KV_ID",
      "preview_id": "REPLACE_WITH_SESSION_KV_PREVIEW_ID"
    }
  ],
  "vars": {
    "EMAIL_TO": "m.liakou@outlook.com"
  }
}
